# Copy this file to .env.postgre.local and fill local runtime settings.
GENIUSAI_POSTGRES_URL=postgresql://localhost:5432/postgres
GENIUSAI_POSTGRES_USER=
GENIUSAI_POSTGRES_PASSWORD=
GENIUSAI_DATABASE_NAME=geniusai-server_qwen3-embedding-0.6b
GENIUSAI_EMBEDDING_MODEL=qwen3-0.6b
#GENIUSAI_DATABASE_NAME=geniusai-server_bge-m3
#GENIUSAI_EMBEDDING_MODEL=bge-m3
GENIUSAI_SERVER_HOST=0.0.0.0
GENIUSAI_SERVER_PORT=19819
# MCP (Model Context Protocol) interface. Enabled by default; served on the SAME
# port as the REST API under GENIUSAI_MCP_PATH. Clients connect to
# http://<host>:<GENIUSAI_SERVER_PORT><GENIUSAI_MCP_PATH> (e.g. .../mcp).
GENIUSAI_MCP_ENABLED=true
GENIUSAI_MCP_PATH=/mcp
GENIUSAI_DATA_DIR=/tmp/geniusai
GENIUSAI_UPLOAD_TEMP_DIR=/tmp/geniusai/uploads
MODEL_CACHE_PATH=/tmp/geniusai/cache
GENIUSAI_FETCH_MODELS=false
GENIUSAI_PRELOAD_MODELS=true
GENIUSAI_DEBUG_LEVEL=0
GENIUSAI_DEBUG_IN_FILE=
